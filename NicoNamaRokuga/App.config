<?xml version="1.0" encoding="utf-8"?>
<configuration>
    <configSections>
        <sectionGroup name="userSettings" type="System.Configuration.UserSettingsGroup, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089">
            <section name="NicoNamaRokuga.Properties.Settings" type="System.Configuration.ClientSettingsSection, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" allowExeDefinition="MachineToLocalUser" requirePermission="false" />
        </sectionGroup>
    </configSections>
    <startup> 
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.6.1" />
    </startup>
    <userSettings>
        <NicoNamaRokuga.Properties.Settings>
            <setting name="UserID" serializeAs="String">
                <value />
            </setting>
            <setting name="Password" serializeAs="String">
                <value />
            </setting>
            <setting name="IsLogin" serializeAs="String">
                <value>always</value>
            </setting>
            <setting name="LoginMethod" serializeAs="String">
                <value>login</value>
            </setting>
            <setting name="IsAllCookie" serializeAs="String">
                <value>False</value>
            </setting>
            <setting name="SaveDir" serializeAs="String">
                <value />
            </setting>
            <setting name="SaveFolder" serializeAs="String">
                <value>rec</value>
            </setting>
            <setting name="SaveFile" serializeAs="String">
                <value>{0}-{2}-{1}</value>
            </setting>
            <setting name="QualityType" serializeAs="String">
                <value>normal</value>
            </setting>
            <setting name="Protocol" serializeAs="String">
                <value>hls</value>
            </setting>
            <setting name="UseExternal" serializeAs="String">
                <value>native</value>
            </setting>
            <setting name="ExecFile" serializeAs="String">
                <value>ffmpeg.exe;ffmpeg.exe</value>
            </setting>
            <setting name="ExecCommand" serializeAs="String">
                <value>%HEADERS% -i "%PARA%" -c copy "%FILE%";%HEADERS% -i "%PARA%" -c copy "%FILE%"</value>
            </setting>
            <setting name="BreakCommand" serializeAs="String">
                <value>q;q</value>
            </setting>
            <setting name="DefaultSaveFolder" serializeAs="String">
                <value>rec</value>
            </setting>
            <setting name="DefaultSaveFile" serializeAs="String">
                <value>{0}-{2}-{1}</value>
            </setting>
            <setting name="DefaultExecFile" serializeAs="String">
                <value>ffmpeg.exe;ffmpeg.exe</value>
            </setting>
            <setting name="DefaultExecCommand" serializeAs="String">
                <value>%HEADERS% -i "%PARA%" -c copy "%FILE%";%HEADERS% -i "%PARA%" -c copy "%FILE%"</value>
            </setting>
            <setting name="IsLogging" serializeAs="String">
                <value>False</value>
            </setting>
            <setting name="Timeout1" serializeAs="String">
                <value>2500</value>
            </setting>
            <setting name="Timeout2" serializeAs="String">
                <value>8000</value>
            </setting>
            <setting name="IsComment" serializeAs="String">
                <value>True</value>
            </setting>
            <setting name="IsSeetNo" serializeAs="String">
                <value>True</value>
            </setting>
            <setting name="ReConnectTime1" serializeAs="String">
                <value>5</value>
            </setting>
            <setting name="Retry" serializeAs="String">
                <value>5</value>
            </setting>
            <setting name="ReConnectTime2" serializeAs="String">
                <value>30</value>
            </setting>
        </NicoNamaRokuga.Properties.Settings>
    </userSettings>
  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <dependentAssembly>
        <assemblyIdentity name="System.Data.SQLite" publicKeyToken="db937bc2d44ff139" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-1.0.109.0" newVersion="1.0.109.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="Newtonsoft.Json" publicKeyToken="30ad4fe6b2a6aeed" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-11.0.0.0" newVersion="11.0.0.0" />
      </dependentAssembly>
    </assemblyBinding>
  </runtime>
</configuration>
